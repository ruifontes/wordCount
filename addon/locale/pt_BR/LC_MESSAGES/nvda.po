#: addon\globalPlugins\wordCount\dialogs.py:24
msgid "Words and its occurrences"
msgstr "Palavras e suas ocorrências"

#. Translators: Ordering options
#: addon\globalPlugins\wordCount\dialogs.py:32
msgid "Order by:"
msgstr "Ordenar por:"

#. Translators: Button to reorder the list
#: addon\globalPlugins\wordCount\dialogs.py:37
msgid "&Reorder"
msgstr "&Reordenar"

#. Translators: Static text to filter the results
#: addon\globalPlugins\wordCount\dialogs.py:42
msgid "Filter:"
msgstr "Filtrar:"

#. Translators: Name of button to show the list of lines containing the selected word
#: addon\globalPlugins\wordCount\dialogs.py:61
msgid "&Show occurrences"
msgstr "&Mostrar ocorrências"

#: addon\globalPlugins\wordCount\dialogs.py:93
msgid "No results"
msgstr "Sem resultados"

#: addon\globalPlugins\wordCount\dialogs.py:96
msgid "1 result"
msgstr "1 resultado"

#: addon\globalPlugins\wordCount\dialogs.py:99
#, python-format
msgid "%d results"
msgstr "%d resultados"

#. Translators: Name of dialog showing the list of lines containing the selected word
#: addon\globalPlugins\wordCount\dialogs.py:136
msgid "Lines containing our word"
msgstr "Linhas contendo a nossa palavra"

#. Translators: Name of button to show the list of lines containing the selected word
#: addon\globalPlugins\wordCount\dialogs.py:150
msgid "&Go to line"
msgstr "&ir para a linha"

#. Translators: Message to announce when no text is selected
#: addon\globalPlugins\wordCount\vars.py:39
msgid "select some text first."
msgstr "selecione algum texto antes."

#: addon\globalPlugins\wordCount\vars.py:85
#: addon\globalPlugins\wordCount\vars.py:86
msgid "There are no words"
msgstr "Não existem palavras"

#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\wordCount\__init__.py:36
msgid "Announces the number of elements in the selected text."
msgstr "Anuncia o número de elementos do texto selecionado."

#. Translators: Name of the section in "Input gestures" dialog.
#: addon\globalPlugins\wordCount\__init__.py:38
#: addon\globalPlugins\wordCount\__init__.py:71
msgid "Text editing"
msgstr "Edição de texto"

#. Translators: Message to announce the number of words and characters
#: addon\globalPlugins\wordCount\__init__.py:53
msgid ""
"{words} words, {characters} characters with spaces, {withoutSpace} "
"characters without spaces in {paragraphs} paragraphs"
msgstr ""
"{words} palavras, {characters} carateres incluindo espaços, {withoutSpace} "
"carateres sem espaços in {paragraphs} paragraphs"

#. Translators: Message to announce the number of words and characters
#: addon\globalPlugins\wordCount\__init__.py:61
msgid ""
"{words} words, {characters} characters with spaces in {paragraphs} paragraphs"
msgstr ""
"{words} palavras e {characters} carateres incluindo espaços em {paragraphs} "
"parágrafos"

#. Translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\wordCount\__init__.py:69
msgid "Opens a dialog with the list of words found in the document."
msgstr "Abre uma janela com a lista de palavras encontradas no documento."

#. Translators: Message to announce it is working...
#: addon\globalPlugins\wordCount\__init__.py:75
msgid "Wait please..."
msgstr "Aguarde por favor..."

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Count elements of the selected text"
msgstr "Conta elementos do texto selecionado"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"announces the number of words, characters and paragraphs of the selected "
"text pressing Control+Shift+F12.\n"
"\tIt also can create a list of the words used, ordered by number of "
"occcurrences or alphabetically, display the lines containing a word and "
"finally move to a specific line, pressing Control+Shift+F11."
msgstr ""
"anuncia o número de palavras, caracteres e parágrafos do texto selecionado "
"pressionando Control+Shift+F12.\n"
"\tEle também pode criar uma lista das palavras usadas, ordenadas por número "
"de ocorrências ou alfabeticamente, exibir as linhas que contêm uma palavra "
"e, por fim, mover para uma linha específica, pressionando Control+Shift+F11."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:30
msgid ""
"Set compatibility with NVDA 2026.1;\n"
"Created option to include spaces in the count of characters."
msgstr ""
"Definir compatibilidade com NVDA 2026.1;\n"
"Criada opção para incluir espaços na contagem de caracteres."

